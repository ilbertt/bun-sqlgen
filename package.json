{
  "name": "bun-sqlgen-monorepo",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run --bun turbo build",
    "check:types": "bun run --bun turbo check:types",
    "check:codestyle": "bun run --bun biome check",
    "check:all": "bun run --parallel --no-exit-on-error check:types check:codestyle",
    "check:commit-message": "bun run --bun commitlint",
    "fix:codestyle": "bun run --bun biome check --write"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@electric-sql/pglite": "^0.5.8",
      "@types/bun": "1.4.2",
      "@typescript/typescript6": "^6.0.2",
      "typescript": "^7.0.2",
      "zod": "^4.6.5"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/format": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "turbo": "^2.11.6"
  },
  "packageManager": "bun@1.4.2"
}
